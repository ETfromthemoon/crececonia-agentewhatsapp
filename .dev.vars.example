# Copia este archivo a `.dev.vars` y rellena los valores.
# `.dev.vars` está en .gitignore — NUNCA se commitea.
# En remoto, carga cada uno con: wrangler secret put <NOMBRE>

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
APP_SECRET=

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Cloudflare AI Gateway (token, si el gateway es autenticado) ---
CF_AIG_TOKEN=

# --- Cal.com ---
CALCOM_API_KEY=

# --- Escalado (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Panel admin ---
ADMIN_TOKEN=
